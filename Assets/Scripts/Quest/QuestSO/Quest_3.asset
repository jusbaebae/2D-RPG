  questId: 3
  npcId: 3
  questName: "\uC880\uBE44\uB97C \uC7A1\uC544\uC918"
  questType: 0
  targetid: Enemy_Zombie
  targetProgress: 5
  prerequisiteQuest: {fileID: 0}
  description: "\uC232 \uAE4A\uC740 \uACF3\uC5D0\uC11C \uC815\uCCB4\uBD88\uBA85\uC758
    \uC880\uBE44\uB4E4\uC774 \uCD9C\uBAB0\uD558\uACE0 \uC788\uB2E4.\n\uACBD\uBE44\uB300\uB9CC\uC73C\uB85C\uB294
    \uBAA8\uB4E0 \uC880\uBE44\uB97C \uB9C9\uC544\uB0B4\uAE30 \uC5B4\uB824\uC6CC \n\uC219\uB828\uB41C
    \uBAA8\uD5D8\uAC00\uC758 \uB3C4\uC6C0\uC774 \uC808\uC2E4\uD558\uB2E4\n\uB9C8\uC744
    \uC8FC\uBCC0\uC744 \uBC30\uD68C\uD558\uB294 \uC880\uBE44\uB4E4\uC744 \uCC98\uCE58\uD558\uC5EC
    \uC8FC\uBBFC\uB4E4\uC758 \uC548\uC804\uC744 \uC9C0\uCF1C\uC8FC\uC790"
  requiredLevel: 9
  rewardGold: 80
  rewardExp: 28
  acceptDialogueLines:
  - "\uC694\uC998 \uC232 \uAE4A\uC740 \uACF3\uC5D0\uC11C \uC880\uBE44\uB4E4\uC774
    \uACC4\uC18D \uCD9C\uBAB0\uD558\uACE0 \uC788\uC5B4"
  - "\uC8FC\uBBFC\uB4E4\uC774 \uBD88\uC548\uC5D0 \uB5A8\uACE0 \uC788\uC5B4\uC11C
    \uB354\uB294 \uBC29\uCE58\uD558\uAE30 \uC5B4\uB824\uC6B4 \uC0C1\uD669\uC774\uC57C"
  - "\uB108 \uC815\uB3C4\uC758 \uC2E4\uB825\uC790\uB77C\uBA74 \uCDA9\uBD84\uD788
    \uC7A1\uC744\uC218 \uC788\uC744\uAC70\uAC19\uC740\uB370\n\uC880 \uB3C4\uC640\uC904\uB798?"
  progressDialogueLines:
  - "\uC880\uBE44\uB294 \uBAA9\uD45C\uAC00 \uBCF4\uC774\uBA74 \uBE60\uB974\uAC8C
    \uB6F0\uC5B4\uC624\uB2C8 \uC870\uC2EC\uD574\uC57C\uD574"
  completeDialogueLines:
  - "\uB3C4\uC640\uC900 \uB355\uBD84\uC5D0 \uC8FC\uBCC0\uC774 \uB9CE\uC774 \uC870\uC6A9\uD574\uC9C4\uAC70\uAC19\uC544
    \uACE0\uB9C8\uC6CC"
  - "\uC774\uAC74 \uB2F5\uB840\uB85C \uBC1B\uC544\uB46C \uB2E4\uC74C\uC5D0 \uAE30\uD68C\uB418\uBA74
    \uB610 \uBD80\uD0C1\uD560\uAC8C"
  targetNpcDialogueLines: []
